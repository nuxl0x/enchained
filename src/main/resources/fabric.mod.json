{
	"schemaVersion": 1,
	"id": "enchained",
	"version": "${version}",
	"name": "Enchained",
	"description": "Agreements. Shackles. Benefit. Ruin.",
	"authors": [
		"nuxlox / nuxl0x",
        "maxryan008",
        "Callumari"
	],
	"contact": {
		"homepage": "https://github.com/nuxl0x/enchained",
		"sources": "https://github.com/nuxl0x/enchained/tree/main",
        "issues": "https://github.com/nuxl0x/enchained/issues"
	},
	"license": "MIT",
	"icon": "assets/enchained/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"value": "nux.enchained.Enchained",
				"adapter": "kotlin"
			}
		],
        "client": [
          "nux.enchained.EnchainedClient"
        ],
		"fabric-datagen": [
			{
				"value": "nux.enchained.EnchainedDataGenerator",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"enchained.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.17.2",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}